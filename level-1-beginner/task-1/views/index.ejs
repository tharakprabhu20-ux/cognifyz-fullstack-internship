<%- include('partials/header', { title: 'Home - Student Registration Desk' }) %>

<!-- Card 1: Student Registration Form -->
<section class="card">
  <div class="card-header">
    <h2 class="card-title">1. New Student Registration</h2>
    <p class="card-subtitle">Fill in the details below to submit your course enrollment application (POST /register).</p>
  </div>

  <form action="/register" method="POST">
    <!-- Full Name Field -->
    <div class="form-group">
      <label for="fullName">Full Name <span class="required">*</span></label>
      <input 
        type="text" 
        id="fullName" 
        name="fullName" 
        placeholder="e.g. Jane Doe" 
        required
      >
    </div>

    <!-- Email Field -->
    <div class="form-group">
      <label for="email">Email Address <span class="required">*</span></label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        placeholder="e.g. jane.doe@example.com" 
        required
      >
    </div>

    <!-- Age Field -->
    <div class="form-group">
      <label for="age">Age (15 - 60) <span class="required">*</span></label>
      <input 
        type="number" 
        id="age" 
        name="age" 
        min="15" 
        max="60" 
        placeholder="Enter age between 15 and 60" 
        required
      >
    </div>

    <!-- Course Selection Field (Rendered dynamically from courses array) -->
    <div class="form-group">
      <label for="course">Preferred Course <span class="required">*</span></label>
      <select id="course" name="course" required>
        <option value="" disabled selected>-- Select a Course --</option>
        <% courses.forEach(function(course) { %>
          <option value="<%= course %>"><%= course %></option>
        <% }); %>
      </select>
    </div>

    <!-- Gender Radio Buttons -->
    <div class="form-group">
      <label id="genderLabel">Gender <span class="required">*</span></label>
      <div class="radio-group" role="radiogroup" aria-labelledby="genderLabel">
        <div class="radio-option">
          <input type="radio" id="genderMale" name="gender" value="Male" required>
          <label for="genderMale">Male</label>
        </div>
        <div class="radio-option">
          <input type="radio" id="genderFemale" name="gender" value="Female" required>
          <label for="genderFemale">Female</label>
        </div>
        <div class="radio-option">
          <input type="radio" id="genderOther" name="gender" value="Other" required>
          <label for="genderOther">Other</label>
        </div>
      </div>
    </div>

    <!-- Areas of Interest Checkboxes (Rendered dynamically from interestOptions array) -->
    <div class="form-group">
      <label id="interestsLabel">Areas of Interest (Select all that apply)</label>
      <div class="checkbox-group" aria-labelledby="interestsLabel">
        <% interestOptions.forEach(function(interest, index) { %>
          <div class="checkbox-option">
            <input 
              type="checkbox" 
              id="interest_<%= index %>" 
              name="interests" 
              value="<%= interest %>"
            >
            <label for="interest_<%= index %>"><%= interest %></label>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- About You Textarea -->
    <div class="form-group">
      <label for="about">About You (Short Bio / Statement of Purpose)</label>
      <textarea 
        id="about" 
        name="about" 
        rows="4" 
        placeholder="Tell us about yourself, your career goals, or your reasons for applying..."
      ></textarea>
    </div>

    <button type="submit" class="btn-primary">Submit Registration</button>
  </form>
</section>

<!-- Card 2: Student Desk Feedback Form -->
<section class="card">
  <div class="card-header">
    <h2 class="card-title">2. Desk Experience Feedback</h2>
    <p class="card-subtitle">Share your feedback regarding the registration desk experience (POST /feedback).</p>
  </div>

  <form action="/feedback" method="POST">
    <!-- Name Field -->
    <div class="form-group">
      <label for="feedbackName">Your Name</label>
      <input 
        type="text" 
        id="feedbackName" 
        name="name" 
        placeholder="Your name (leave blank for Anonymous)"
      >
    </div>

    <!-- Rating Dropdown (5 down to 1) -->
    <div class="form-group">
      <label for="feedbackRating">Rating <span class="required">*</span></label>
      <select id="feedbackRating" name="rating" required>
        <option value="" disabled selected>-- Select Rating --</option>
        <option value="5">5 - Excellent (⭐⭐⭐⭐⭐)</option>
        <option value="4">4 - Good (⭐⭐⭐⭐)</option>
        <option value="3">3 - Average (⭐⭐⭐)</option>
        <option value="2">2 - Below Average (⭐⭐)</option>
        <option value="1">1 - Poor (⭐)</option>
      </select>
    </div>

    <!-- Feedback Comment Textarea -->
    <div class="form-group">
      <label for="feedbackComment">Your Comments</label>
      <textarea 
        id="feedbackComment" 
        name="comment" 
        rows="3" 
        placeholder="What did you like or how could we improve the process?"
      ></textarea>
    </div>

    <button type="submit" class="btn-primary">Submit Feedback</button>
  </form>
</section>

<!-- Card 3: Course Search Form -->
<section class="card">
  <div class="card-header">
    <h2 class="card-title">3. Course Catalog Search</h2>
    <p class="card-subtitle">Search for offered courses using a keyword query (GET /search).</p>
  </div>

  <form action="/search" method="GET">
    <div class="form-group">
      <label for="searchQuery">Search Query <span class="required">*</span></label>
      <input 
        type="text" 
        id="searchQuery" 
        name="q" 
        placeholder="Enter keyword, e.g. 'Science', 'BCA', 'Technology'..." 
        required
      >
    </div>

    <button type="submit" class="btn-primary">Search Courses</button>
  </form>
</section>

<%- include('partials/footer') %>

