<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Student Registration Desk' %> | Cognifyz Internship</title>
  <!-- Minimal layout styling: body background, container, and navigation header. Form element styles are applied inline per task objectives. -->
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: #f1f5f9;
      color: #1e293b;
      line-height: 1.6;
    }
    .main-container {
      max-width: 760px;
      margin: 0 auto;
      padding: 28px 16px 48px;
    }
    .header-nav {
      background-color: #0f172a;
      color: #f8fafc;
      padding: 16px 20px;
      border-bottom: 2px solid #1e293b;
    }
    .header-content {
      max-width: 760px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .header-title {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #ffffff;
      text-decoration: none;
    }
    .nav-links {
      display: flex;
      gap: 16px;
      list-style: none;
      margin: 0;
      padding: 0;
      align-items: center;
    }
    .nav-links a {
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      padding: 6px 12px;
      border-radius: 6px;
      transition: color 0.15s ease, background-color 0.15s ease;
    }
    .nav-links a:hover,
    .nav-links a:focus {
      color: #ffffff;
      background-color: #1e293b;
      outline: 2px solid #38bdf8;
      outline-offset: 2px;
    }
    .nav-links a.active {
      color: #38bdf8;
      background-color: #1e293b;
    }
  </style>
</head>
<body>
  <!-- Header: Dark Navy Header with Branding and Nav Links (Step 1 & Design Requirements) -->
  <header class="header-nav" role="banner">
    <div class="header-content">
      <a href="/" class="header-title" aria-label="Student Registration Desk Home">
        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background-color: #38bdf8;"></span>
        Student Registration Desk
      </a>
      <nav aria-label="Main Navigation">
        <ul class="nav-links">
          <li><a href="/" class="<%= typeof activePage !== 'undefined' && activePage === 'register' ? 'active' : '' %>">Register</a></li>
          <li><a href="/submissions" class="<%= typeof activePage !== 'undefined' && activePage === 'submissions' ? 'active' : '' %>">Submissions</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Main Content Container: Opens <main> tag -->
  <main class="main-container" role="main">

